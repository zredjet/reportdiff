<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fixtures/row-surfaces/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-global/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-multiple/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-shared/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-ambiguity/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-same-page-support/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-anchored-acceptance/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-terminal-shared/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-unpaired/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow-numeric/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/page-flow/**" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../reference/golden/**" Link="golden/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/batch/*.yaml" Link="examples/batch/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/*.yaml" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ReportDiff.Core/ReportDiff.Core.csproj" />
    <ProjectReference Include="../../src/ReportDiff.Pdf/ReportDiff.Pdf.csproj" />
    <ProjectReference Include="../../src/ReportDiff.Report/ReportDiff.Report.csproj" />
    <ProjectReference Include="../../src/ReportDiff.Cli/ReportDiff.Cli.csproj" />
  </ItemGroup>
</Project>
